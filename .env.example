NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 가온형사사법지원포털 호스트. 안심피싱 도메인과 반드시 분리합니다.
# 로컬: http://gaoncs.localhost:3000 또는 npm run dev:portal → http://localhost:3001
# 배포: https://gaoncs.vercel.app
NEXT_PUBLIC_PORTAL_HOSTS=gaoncs.localhost,gaoncs.vercel.app
# 포털 전용 Vercel 프로젝트면 true. 이 호스트에서는 안심피싱이 열리지 않습니다.
# NEXT_PUBLIC_PORTAL_ONLY=true

# Vercel
# Production (main / live): 실제 백엔드 URL
# Preview (develop / staging, PR): 스테이징 백엔드 URL
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
